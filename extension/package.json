  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "homepage": "https://github.com/michael-berardi/ultracompress#readme",
  "bugs": {
    "url": "https://github.com/michael-berardi/ultracompress/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "ultracompress",
    "compaction",
    "vcc",
    "snapcompact",
    "ultracompact"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-berardi/ultracompress.git"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <0.86.0",
    "typebox": ">=1.1.24 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.4.1",
    "typebox": "^1.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
